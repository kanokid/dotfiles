layout {

    focus-ring {
        active-color   "#006874"
        inactive-color "#f5fafb"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#006874"
        inactive-color "#f5fafb"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#006874"
        inactive-color "#9eeffd"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00687480"
    }
}

recent-windows {
    highlight {
        active-color "#006874"
        urgent-color "#ba1a1a"
    }
}
