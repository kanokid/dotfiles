local M = "SUPER"

hl.config({
    autogenerated = false,

    env = {
        "QT_QPA_PLATFORMTHEME,qt6ct"
    },

    monitor = {
        ", 1920x1080@120, 1280x0, 2"
    },

    input = {
        kb_layout = "us",
        numlock_by_default = true,

        touchpad = {
            natural_scroll = true,
            tap_to_click = true
        },

        -- Match mouse acceleration
        sensitivity = 0.3
    },

    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 4,

        col = {
            active_border = "rgba(36cd40ff)",
            inactive_border = "rgba(505050ff)"
        },

        layout = "dwindle"
    },

    dwindle = {
        pseudotile = true,
        preserve_split = true,
        smart_split = true
    },

    master = {
        mfact = 0.55,
        new_status = "master",
        orientation = "left"
    },

    decoration = {
        shadow = {
            enabled = true,
            range = 30,
            render_power = 3,
            color = "rgba(00000077)",
            offset = "0 5"
        }
    },

    windowrulev2 = {
        -- Opacities
        { rule = "opacity 0.80 0.80", class = "^(com.mitchellh.ghostty|code)$" },
        { rule = "opacity 0.95 0.95", class = "^(spotify)$" },
        { rule = "opacity 0.95 0.95", class = "^(firefox)$" },
        { rule = "opacity 0.80 0.80", class = "^(Slack)$" },
        { rule = "opacity 0.95 0.95", class = "^(org.gnome.Nautilus)$" },

        -- Floating
        { rule = "float", class = "^(Noctalia)$" },
        { rule = "float", class = "^(firefox)$", title = "^(Picture-in-Picture)$" },

        -- Godot sizing
        { rule = "nomaxsize", class = "^(Godot)$" },
        { rule = "size 75% 75%", class = "^(Godot)$" }
    },

    layerrule = {
        { rule = "blur", namespace = "^noctalia-overview*" }
    }
})

-- =============================================================================
-- STARTUP PROCESSES
-- =============================================================================

hl.dsp.exec("noctalia --daemon")
hl.dsp.exec("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")

-- =============================================================================
-- KEYBINDINGS
-- =============================================================================

-- Applications & Shell Interface
hl.bind(M .. " + RETURN", hl.dsp.exec("ghostty"))
hl.bind(M .. " + D", hl.dsp.exec("noctalia msg panel-toggle launcher"))
hl.bind("SUPER_ALT + L", hl.dsp.exec("noctalia msg session lock"))
hl.bind(M .. " + E", hl.dsp.exec("code"))
hl.bind(M .. " + B", hl.dsp.exec("firefox"))
hl.bind("SUPER + F", hl.dsp.exec("nautilus"))
hl.bind(M .. " + SHIFT + A", hl.dsp.exec("kde-discover"))
hl.bind("SUPER + S", hl.dsp.exec("slack"))
hl.bind("SUPER + G", hl.dsp.exec("github-desktop"))
hl.bind("SUPER + M", hl.dsp.exec("spotify"))
hl.bind("SUPER_ALT + G", hl.dsp.exec("~/Downloads/Godot"))

-- Window Controls
hl.bind(M .. " + Q", hl.dsp.window.kill_active())
hl.bind(M .. " + V", hl.dsp.window.toggle_floating())
hl.bind(M .. " + SHIFT + F", hl.dsp.window.toggle_fullscreen(1))

-- Layout Toggle (Dwindle / Master)
local current_layout = "dwindle"
hl.bind(M .. " + Space", function()
    if current_layout == "dwindle" then
        current_layout = "master"
    else
        current_layout = "dwindle"
    end
    hl.config({ general = { layout = current_layout } })
end)

-- Focus Movement (Arrows)
hl.bind(M .. " + Left", hl.dsp.layout.move_focus("l"))
hl.bind(M .. " + Right", hl.dsp.layout.move_focus("r"))
hl.bind(M .. " + Up", hl.dsp.layout.move_focus("u"))
hl.bind(M .. " + Down", hl.dsp.layout.move_focus("d"))

-- Focus Movement (Vim hjkl)
hl.bind(M .. " + H", hl.dsp.layout.move_focus("l"))
hl.bind(M .. " + L", hl.dsp.layout.move_focus("r"))
hl.bind(M .. " + K", hl.dsp.layout.move_focus("u"))
hl.bind(M .. " + J", hl.dsp.layout.move_focus("d"))

-- Window Swapping (Arrows)
hl.bind(M .. " + CTRL + Left", hl.dsp.layout.move_window("l"))
hl.bind(M .. " + CTRL + Right", hl.dsp.layout.move_window("r"))
hl.bind(M .. " + CTRL + Up", hl.dsp.layout.move_window("u"))
hl.bind(M .. " + CTRL + Down", hl.dsp.layout.move_window("d"))

-- Window Swapping (Vim hjkl)
hl.bind(M .. " + CTRL + H", hl.dsp.layout.move_window("l"))
hl.bind(M .. " + CTRL + L", hl.dsp.layout.move_window("r"))
hl.bind(M .. " + CTRL + K", hl.dsp.layout.move_window("u"))
hl.bind(M .. " + CTRL + J", hl.dsp.layout.move_window("d"))

-- Workspaces
for i = 1, 9 do
    hl.bind(M .. " + " .. i, hl.dsp.workspace.focus(i))
    hl.bind(M .. " + CTRL + " .. i, hl.dsp.window.move_to_workspace(i))
end

-- Audio
hl.bind(", XF86AudioRaiseVolume", hl.dsp.exec("wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"), { e = true })
hl.bind(", XF86AudioLowerVolume", hl.dsp.exec("wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"), { e = true })
hl.bind(", XF86AudioMute", hl.dsp.exec("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { l = true })
hl.bind(", XF86AudioMicMute", hl.dsp.exec("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { l = true })

-- Media Control
hl.bind(", XF86AudioPlay", hl.dsp.exec("noctalia msg media toggle"), { l = true })
hl.bind(", XF86AudioStop", hl.dsp.exec("noctalia msg media stop"), { l = true })
hl.bind(", XF86AudioPrev", hl.dsp.exec("noctalia msg media previous"), { l = true })
hl.bind(", XF86AudioNext", hl.dsp.exec("noctalia msg media next"), { l = true })

-- Backlight
hl.bind(", XF86MonBrightnessUp", hl.dsp.exec("brightnessctl set +5%"), { e = true })
hl.bind(", XF86MonBrightnessDown", hl.dsp.exec("brightnessctl set 5%-"), { e = true })

-- Screenshots
hl.bind(", Print", hl.dsp.exec("noctalia msg screenshot-region"))
hl.bind("CTRL, Print", hl.dsp.exec("noctalia msg screenshot-fullscreen"))
hl.bind("ALT, Print", hl.dsp.exec("noctalia msg screenshot-fullscreen pick"))

-- Window Switcher
hl.bind("ALT, Tab", hl.dsp.exec("noctalia msg window-switcher"))

-- System Exit
hl.bind(M .. " + SHIFT + E", hl.dsp.core.exit())
hl.bind("CTRL_ALT + Delete", hl.dsp.core.exit())